# ============================================================
# AI Shop Assistant – vzor konfigurace
# Zkopírujte na .env a doplňte hodnoty. .env NIKDY necommitujte.
# ============================================================

# --- Obecné ---
APP_DOMAIN=localhost
ACME_EMAIL=admin@example.com
# Lokální provoz bez HTTPS: http://localhost. Na serveru ponechte doménu (APP_DOMAIN).
CADDY_SITE_ADDRESS=
# Porty Caddy na hostu (když je 80/443 obsazený jinou službou)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Přímý port pro frontend: 8085 = veřejně, 127.0.0.1:5173 = jen lokálně
FRONTEND_PORT=5173
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:5173
TZ=Europe/Prague

# --- MongoDB ---
MONGO_DATABASE=shopassistant
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_ROOT
MONGO_APP_USER=app
MONGO_APP_PASSWORD=CHANGE_ME_APP
# Pro vývoj mimo Docker (backend na hostu):
MONGO_URI=mongodb://app:CHANGE_ME_APP@localhost:27017/shopassistant?authSource=shopassistant

# --- První admin (pouze při spuštění s --seed-admin) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Bezpečnost ---
# Vygenerujte např. příkazem: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_256_BIT
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Úložiště souborů ---
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads
UPLOAD_MAX_MB=8

# --- AI ---
AI_PROVIDER_TEXT=gemini
AI_PROVIDER_IMAGE=fake
GEMINI_API_KEY=
AI_MODEL_TEXT=gemini-3.1-flash-lite
AI_MAX_RETRIES=3
AI_RATE_LIMIT_ATTEMPTS=20
AI_RATE_LIMIT_WINDOW_MINUTES=5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_COST_INPUT_USD_PER_M=0.30
AI_COST_OUTPUT_USD_PER_M=2.50
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1.5
AI_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Limity ---
LIMIT_REQUESTS_PER_DAY=20
LIMIT_MODEL_PHOTOS_PER_DAY=3
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
PIPELINE_ENABLED=true
PIPELINE_POLL_MS=2000

# --- Frontend (Vite, volitelné) ---
VITE_API_BASE_URL=/api/v1
