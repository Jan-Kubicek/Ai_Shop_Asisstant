# ============================================================
# AI Shop Assistant – vzor konfigurace
# Zkopírujte na .env a doplňte hodnoty. .env NIKDY necommitujte.
# ============================================================

# --- Obecné ---
APP_DOMAIN=localhost
ACME_EMAIL=admin@example.com
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:5173
TZ=Europe/Prague

# --- MongoDB ---
MONGO_DATABASE=shopassistant
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_ROOT
MONGO_APP_USER=app
MONGO_APP_PASSWORD=CHANGE_ME_APP
# Pro vývoj mimo Docker (backend na hostu):
MONGO_URI=mongodb://app:CHANGE_ME_APP@localhost:27017/shopassistant?authSource=shopassistant

# --- První admin (pouze při spuštění s --seed-admin) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Bezpečnost ---
# Vygenerujte např. příkazem: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_256_BIT
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Úložiště souborů ---
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads
UPLOAD_MAX_MB=8

# --- AI ---
AI_PROVIDER_TEXT=gemini
AI_PROVIDER_IMAGE=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Limity ---
LIMIT_REQUESTS_PER_DAY=20
LIMIT_MODEL_PHOTOS_PER_DAY=3

# --- Frontend (Vite, volitelné) ---
VITE_API_BASE_URL=/api/v1
