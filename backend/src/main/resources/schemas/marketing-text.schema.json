{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.cz/schemas/marketing-text.schema.json",
  "title": "MarketingText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title", "shortDescription", "longDescription", "keywords",
    "usp", "audience", "tone", "marketingAngle"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "shortDescription": { "type": "string", "minLength": 10, "maxLength": 300 },
    "longDescription": { "type": "string", "minLength": 50, "maxLength": 2500 },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 15,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 }
    },
    "usp": { "type": "string", "minLength": 10, "maxLength": 300 },
    "audience": { "type": "string", "minLength": 5, "maxLength": 300 },
    "tone": { "type": "string", "minLength": 5, "maxLength": 300 },
    "marketingAngle": { "type": "string", "minLength": 10, "maxLength": 500 }
  }
}
