{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.cz/schemas/woo-product.schema.json",
  "title": "WooProductExport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "requestId", "product", "social"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "status", "short_description", "description", "images"],
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["simple"] },
        "status": { "type": "string", "enum": ["draft"] },
        "short_description": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 10000 },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "maxLength": 100 }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "maxLength": 100 }
            }
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt"],
            "properties": {
              "src": { "type": "string", "maxLength": 255 },
              "alt": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "variations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size", "price"],
            "properties": {
              "size": { "type": "integer" },
              "price": { "type": "number", "minimum": 0 }
            }
          }
        },
        "meta_data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "properties": {
              "key": { "type": "string", "maxLength": 100 },
              "value": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    "social": {
      "type": "object",
      "required": ["instagram", "facebook"],
      "properties": {
        "instagram": {
          "type": "object",
          "required": ["caption", "hashtags"],
          "properties": {
            "caption": { "type": "string", "maxLength": 2200 },
            "hashtags": {
              "type": "array",
              "items": { "type": "string", "maxLength": 60 }
            }
          }
        },
        "facebook": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "maxLength": 5000 }
          }
        }
      }
    }
  }
}
